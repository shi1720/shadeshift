{
  "name": "shadeshift",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 5173",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/model.test.ts",
    "test:e2e": "playwright test",
    "data:verify": "node --import tsx scripts/verify-data.ts",
    "data:rebuild": "python3 scripts/fetch-host-climate.py",
    "data:refresh": "python3 scripts/fetch-host-climate.py --refresh",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes,auth --project shadeshift-city",
    "test:rules": "firebase emulators:exec --only firestore --project demo-shadeshift \"node --import tsx --test tests/firestore.test.ts\"",
    "dev:emulator": "VITE_USE_FIREBASE_EMULATORS=true vite"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "firebase-tools": "^15.30.1",
    "prettier": "^3.9.7",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@eslint/js": "^9.39.4",
    "typescript-eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.0.1"
  },
  "type": "module",
  "description": "Transparent heat-aware event investment planning"
}
